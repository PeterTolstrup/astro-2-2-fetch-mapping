<style>
  section {
    padding: 10%;
  }

  .cards {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    padding-top: 2rem;
  }

  .two-columns {
    padding-top: 2rem;
    column-count: 2;
  }
</style>
